PORT=3000

# ---- Base de datos MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=juego_recuerdos
# Solo para bases de datos en la nube (Aiven, etc.): conexion cifrada
# DB_SSL=true
# DB_SSL_CA=          (opcional) texto del certificado CA o ruta al archivo

# Cambie este valor por un texto largo y aleatorio
SESSION_SECRET=cambie_esto_por_un_texto_largo_y_aleatorio

# ---- Recuperacion de contraseña ----
# Direccion publica de la aplicacion: va dentro del enlace que llega por correo.
# En Render sera algo como https://juegos-memoria.onrender.com
BASE_URL=http://localhost:3000

# Envio de correos con Brevo (plan gratis). Si se dejan vacios, en tu computador
# el enlace de recuperacion se imprime en la consola en vez de enviarse.
# BREVO_API_KEY=
# CORREO_REMITENTE=tu_correo_verificado@ejemplo.com
# CORREO_NOMBRE=Juegos de memoria
